#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC 0
#define WIN 1
#define RIG 2
#define LEF 3
#define TRI 4
#define MOUSE 5

// https://zmk.dev/docs/development/hardware-integration/soft-off-setup?advanced-methods=wakeup&kscan-type=dkscan

/ {
    keys {
        compatible = "gpio-keys";

        soft_off_gpio_key: soft_off_gpio_key { gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
    };

    wakeup_scan: wakeup_scan {
        compatible = "zmk,kscan-gpio-direct";
        input-keys = <&soft_off_gpio_key>;
        wakeup-source;
    };

    side_band_behavior_triggers: side_band_behavior_triggers {
        compatible = "zmk,kscan-sideband-behaviors";
        kscan = <&wakeup_scan>;
        auto-enable;
        wakeup-source;
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_scan>;
    };
};

/ {
    chosen { zmk,charmap = &charmap_us; };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <11 12 13 16 17 18 10 19>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        msl: Mod_S_Layer {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod_S_Layer";
            bindings = <&kp>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };

        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <300>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <0>;      // 0
            time-to-max-speed-ms = <40>;      // 500
            delay-ms = <0>;                   // 10
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Numbers {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Func {
            bindings = <&mo 4>;
            key-positions = <32 31>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 20>;
        };
    };

    macros {
        TBack: TBack {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "TBACK";
        };

        TNext: TNext {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "TNEXT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_layer {
            display-name = "Def";
            bindings = <
&kp Q  &kp W            &kp L                &kp D             &kp P                &kp K               &kp M              &kp U                 &kp Y             &kp ESCAPE
&kp A  &hml LEFT_ALT S  &hml LEFT_CONTROL R  &hml LEFT_META T  &hml LEFT_SHIFT G    &hmr RIGHT_SHIFT F  &hmr RIGHT_META N  &hmr RIGHT_CONTROL E  &hmr RIGHT_ALT I  &kp O
&kp Z  &kp X            &kp C                &kp V             &kp J                &kp B               &kp H              &kp COMMA             &kp SLASH         &kp DOT
                                             &lt 1 SPACE       &kp ENTER            &sk LEFT_SHIFT      &lt 2 BACKSPACE
            >;
        };

        Navigation {
            display-name = "Nav";
            bindings = <
&bootloader  &trans        &trans            &trans         &trans            &trans      &kp K_CONTEXT_MENU  &kp PRINTSCREEN  &kp CAPS       &trans
&trans       &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_META  &kp LEFT_SHIFT    &kp LEFT    &kp DOWN_ARROW      &kp UP_ARROW     &kp RIGHT      &kp DELETE
&trans       &trans        &trans            &trans         &trans            &kp K_BACK  &TBack              &TNext           &kp K_FORWARD  &trans
                                             &trans         &trans            &trans      &trans
            >;
        };

        Mouse {
            display-name = "Mou";
            bindings = <
&trans   &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans           &trans          &trans             &trans         &bootloader
&kp TAB  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &kp RIGHT_SHIFT  &kp RIGHT_META  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &trans
&trans   &mkp MCLK       &mkp RCLK     &mkp LCLK       &trans             &trans           &trans          &trans             &trans         &trans
                                       &trans          &trans             &trans           &trans
            >;
        };

        Numbers {
            display-name = "Num";
            bindings = <
&trans           &trans        &kp MINUS     &kp EQUAL     &kp GRAVE       &kp BACKSLASH  &kp SEMICOLON  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6   &kp NUMBER_7   &kp NUMBER_8      &kp NUMBER_9          &kp NUMBER_0
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET      &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
                                             &trans        &trans          &trans         &trans
            >;
        };

        Functions {
            display-name = "Func";
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4      &kp F5            &kp F6        &kp F7          &kp F8        &kp F9    &kp F10
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bt BT_CLR_ALL    &kp K_MUTE    &kp C_VOL_DN    &kp C_VOL_UP  &kp C_PP  &kp C_NEXT
&kp F11       &kp F12       &trans        &trans      &trans            &out OUT_TOG  &studio_unlock  &soft_off     &trans    &trans
                                          &trans      &trans            &trans        &trans
            >;
        };
    };
};
